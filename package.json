{
  "name": "rn-web-audio-compat",
  "version": "0.1.0",
  "description": "The Web Audio API on React Native: AudioWorkletNode, DynamicsCompressorNode, channel routing, browser-style globals and native C++ effect kernels, on top of react-native-audio-api's stable extension API.",
  "license": "MIT",
  "author": "Willie Wrinkle",
  "contributors": [
    "Claude (Anthropic) <noreply@anthropic.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwrinkle/rn-web-audio-compat.git"
  },
  "homepage": "https://github.com/wwrinkle/rn-web-audio-compat#readme",
  "keywords": [
    "react-native",
    "web-audio",
    "audio-worklet",
    "react-native-audio-api",
    "dsp",
    "tone.js"
  ],
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./globals": "./src/globals.ts",
    "./tone": {
      "browser": "./src/tone/index.web.ts",
      "react-native": "./src/tone/index.ts",
      "default": "./src/tone/index.ts"
    },
    "./scripts/apply-native": "./scripts/apply-native.js",
    "./scripts/kernel-parity/writeRefs": "./scripts/kernel-parity/writeRefs.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "common",
    "!common/cpp/rnwac_ext",
    "android",
    "!android/build",
    "!android/.cxx",
    "ios",
    "CMakeLists.txt",
    "RNWebAudioCompat.podspec",
    "react-native.config.js",
    "scripts",
    "native",
    "docs",
    "COVERAGE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "parity": "bash scripts/kernel-parity/run.sh src/__tests__/kernelParity.test.ts",
    "typecheck": "cd example && npx tsc --noEmit",
    "coverage": "tsx scripts/gen-coverage.ts"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-audio-api": "^1.0.1",
    "react-native-audio-worklets": "^0.1.0",
    "react-native-worklets": ">=0.10.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "tsx": "^4.23.15"
  },
  "codegenConfig": {
    "name": "rnwebaudiocompat",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.rnwebaudiocompat"
    },
    "ios": {
      "modulesProvider": {
        "NativeWebAudioCompatModule": "NativeWebAudioCompatModuleProvider"
      }
    }
  },
  "peerDependenciesMeta": {
    "tone": {
      "optional": true
    }
  }
}
