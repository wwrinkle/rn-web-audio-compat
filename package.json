{
  "name": "rn-web-audio-compat",
  "version": "0.1.0",
  "description": "The Web Audio API on React Native: AudioWorkletNode, DynamicsCompressorNode, channel routing, browser-style globals and native C++ effect kernels, on top of react-native-audio-api.",
  "license": "MIT",
  "author": "Willie Wrinkle",
  "contributors": [
    "Claude (Anthropic) <noreply@anthropic.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwrinkle/rn-web-audio-compat.git"
  },
  "homepage": "https://github.com/wwrinkle/rn-web-audio-compat#readme",
  "keywords": ["react-native", "web-audio", "audio-worklet", "react-native-audio-api", "dsp"],
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./globals": "./src/globals.ts",
    "./scripts/apply-native": "./scripts/apply-native.js",
    "./scripts/kernel-parity/writeRefs": "./scripts/kernel-parity/writeRefs.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "rn-web-audio-compat-apply": "scripts/apply-native.js"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "native",
    "scripts",
    "COVERAGE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-native.js",
    "test": "jest",
    "parity": "bash scripts/kernel-parity/run.sh src/__tests__/kernelParity.test.ts",
    "typecheck": "cd example && npx tsc --noEmit"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-audio-api": "0.13.5",
    "react-native-worklets": ">=0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  }
}
