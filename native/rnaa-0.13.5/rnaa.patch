+JSI_HOST_FUNCTION_IMPL(BaseAudioContextHostObject, getKernelTimings) {
+  std::vector<jsi::Value> entries;
+  {
+    // Entry id 0: the whole render callback (rnwac::RenderTiming), not a kernel.
