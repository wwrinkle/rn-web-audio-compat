+    }
+    auto &timing = rnwac::g_kernelTiming[id];
+    uint64_t count = timing.count.load(std::memory_order_relaxed);
+    uint64_t totalNs = timing.totalNs.load(std::memory_order_relaxed);
+    uint64_t maxNs = timing.maxNs.load(std::memory_order_relaxed);
+
+    auto entry = jsi::Object(runtime);
+    entry.setProperty(runtime, "id", jsi::Value(id));
+    entry.setProperty(
+        runtime, "name", jsi::String::createFromUtf8(runtime, name));
+    entry.setProperty(runtime, "count", jsi::Value(static_cast<double>(count)));
+    entry.setProperty(
+        runtime,
+        "avgUs",
+        jsi::Value(count > 0 ? (static_cast<double>(totalNs) / static_cast<double>(count)) / 1000.0 : 0.0));
+    entry.setProperty(runtime, "maxUs", jsi::Value(static_cast<double>(maxNs) / 1000.0));
+    entries.emplace_back(std::move(entry));
+  }
